/*
 * Per-process options: extra tool arguments (ext.args) and where results are published.
 */
process {

    withName: 'GUNZIP|GFFREAD|CAT_FASTQ' {
        publishDir = [ enabled: false ]
    }

    withName: 'TX2GENE' {
        publishDir = [ path: { "${params.outdir}/quantification" }, mode: params.publish_dir_mode ]
    }

    withName: 'FASTQC' {
        ext.args   = '--quiet'
        publishDir = [ path: { "${params.outdir}/fastqc" }, mode: params.publish_dir_mode ]
    }

    withName: 'FASTP' {
        ext.args   = '--length_required 25'
        publishDir = [ path: { "${params.outdir}/fastp" }, mode: params.publish_dir_mode, pattern: '*.{json,html,log}' ]
    }

    withName: 'SALMON_INDEX' {
        ext.args   = '-k 31'
        publishDir = [ path: { "${params.outdir}/reference" }, mode: params.publish_dir_mode ]
    }

    withName: 'SALMON_QUANT' {
        // selective alignment is the default in Salmon >= 1.0; bias models improve abundance accuracy
        ext.args   = '--validateMappings --seqBias'
        publishDir = [ path: { "${params.outdir}/salmon" }, mode: params.publish_dir_mode ]
    }

    withName: 'STAR_GENOMEGENERATE' {
        publishDir = [ path: { "${params.outdir}/reference" }, mode: params.publish_dir_mode ]
    }

    withName: 'STAR_ALIGN' {
        // ENCODE long-RNA options
        ext.args   = [
            '--outFilterType BySJout',
            '--outFilterMultimapNmax 20',
            '--alignSJoverhangMin 8',
            '--alignSJDBoverhangMin 1',
            '--outFilterMismatchNmax 999',
            '--outFilterMismatchNoverReadLmax 0.04',
            '--alignIntronMin 20',
            '--alignIntronMax 1000000',
            '--alignMatesGapMax 1000000',
            '--outSAMattributes NH HI AS NM MD',
            '--outSAMstrandField intronMotif'
        ].join(' ')
        publishDir = [
            path: { "${params.outdir}/star" },
            mode: params.publish_dir_mode,
            saveAs: { fn -> fn.endsWith('.bam') && !params.save_bam ? null : fn }
        ]
    }

    withName: 'SAMTOOLS_STATS' {
        publishDir = [
            path: { "${params.outdir}/star" },
            mode: params.publish_dir_mode,
            saveAs: { fn -> fn.endsWith('.bai') && !params.save_bam ? null : fn }
        ]
    }

    withName: 'QUANT_CONCORDANCE' {
        publishDir = [
            [ path: { "${params.outdir}/quantification" }, mode: params.publish_dir_mode, pattern: '{salmon,star}.*.tsv' ],
            [ path: { "${params.outdir}/concordance" },    mode: params.publish_dir_mode, pattern: '{concordance,strandedness}*' ]
        ]
    }

    withName: 'DESEQ2' {
        publishDir = [ path: { "${params.outdir}/differential_expression" }, mode: params.publish_dir_mode, pattern: 'deseq2/**', saveAs: { fn -> fn - 'deseq2/' } ]
    }

    withName: 'MULTIQC' {
        publishDir = [ path: { "${params.outdir}/multiqc" }, mode: params.publish_dir_mode ]
    }
}
