/*
 * Small bundled test: simulated stranded paired-end reads from S. cerevisiae chromosome I,
 * two conditions x three replicates, with a known set of differentially expressed genes.
 *
 *   nextflow run bioxflow/rnaseq -profile test,conda   (or test,docker)
 */
params {
    input      = "${projectDir}/assets/testdata/samplesheet.csv"
    fasta      = "${projectDir}/assets/testdata/genome.fa.gz"
    gtf        = "${projectDir}/assets/testdata/genes.gtf.gz"
    outdir     = 'results_test'

    // The test libraries hold only ~10,000 read pairs over ~100 genes, so per-gene counts
    // are noisy; the default threshold of 0.9 is meant for real sequencing depths.
    concordance_threshold = 0.85

}

process.resourceLimits = [ cpus: 2, memory: 6.GB, time: 1.h ]
