/*
 * bioxflow/rnaseq — default configuration
 */

params {
    // Input / output
    input                 = null
    outdir                = 'results'

    // Reference
    fasta                 = null
    gtf                   = null
    transcript_fasta      = null
    gencode               = false
    salmon_index          = null
    star_index            = null
    salmon_decoys         = true

    // Workflow switches
    skip_fastqc           = false
    skip_trimming         = false
    skip_alignment        = false
    skip_de               = false
    save_bam              = true

    // Differential expression
    reference_condition   = null
    contrasts             = null
    alpha                 = 0.05
    lfc_threshold         = 0
    min_count             = 10

    // Dual-quantification concordance
    concordance_threshold = 0.9

    // Resources: upper limits for any single process.
    // Default to what this machine has; set them explicitly on a cluster.
    max_cpus              = Runtime.runtime.availableProcessors()
    max_memory            = "${(java.lang.management.ManagementFactory.getOperatingSystemMXBean().getTotalMemorySize() / 1073741824L) as int}.GB"
    max_time              = '72.h'

    // Misc
    publish_dir_mode      = 'copy'
    help                  = false
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    conda {
        conda.enabled          = true
        conda.channels         = ['conda-forge', 'bioconda']
        docker.enabled         = false
        singularity.enabled    = false
    }
    mamba {
        conda.enabled          = true
        conda.useMamba         = true
        conda.channels         = ['conda-forge', 'bioconda']
    }
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        conda.enabled          = false
    }
    arm {
        docker.runOptions      = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
    }
    apptainer {
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        conda.enabled          = false
    }
    laptop    { includeConfig 'conf/laptop.config' }
    test      { includeConfig 'conf/test.config' }
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
}

manifest {
    name            = 'bioxflow/rnaseq'
    description     = 'Bulk RNA-seq with dual-evidence quantification (Salmon + STAR), cross-method concordance checks and DESeq2 differential expression'
    homePage        = 'https://www.bioxflow.uk'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=25.04.0'
    version         = '1.0.0'
    license         = 'MIT'
}
